# Rosy AI — environment variable names only. NEVER commit real values here.
# Copy to .env (git-ignored) or set these in your hosting provider's dashboard.

# ---------------------------------------------------------------------------
# Browser-visible (safe to expose — publishable identifiers only)
# Anything with the VITE_ prefix is inlined into the JavaScript the browser
# downloads. Never put a private key, service key or integration secret here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Server-only (never prefixed with VITE_, never sent to the browser)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Bypasses row-level security. Server-side privileged work only.
SUPABASE_SERVICE_ROLE_KEY=

# Rosy bot narrative generation (AI gateway). Server-only.
LOVABLE_API_KEY=

# Shared secret for scheduled/cron callbacks. Server-only.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Future read-only integrations — NOT yet implemented and NOT yet required.
# When they are wired up, each MUST stay server-only (no VITE_ prefix) and be
# read inside a server function handler, never in client code.
# ---------------------------------------------------------------------------
# FOODICS_API_TOKEN=
# GRUBTECH_API_KEY=
# SUPY_API_KEY=
# EAT_APP_API_KEY=
# HR_PROVIDER_API_KEY=
# ACCOUNTING_PROVIDER_API_KEY=
